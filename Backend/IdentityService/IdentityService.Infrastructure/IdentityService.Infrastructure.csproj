<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Project References -->
    <ProjectReference Include="..\..\Shared\SharedLibrary\SharedLibrary.csproj" />
    <ProjectReference Include="..\IdentityService.Domain\IdentityService.Domain.csproj" />
    <ProjectReference Include="..\IdentityService.Application\IdentityService.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Core Packages -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.9" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />

    <!-- gRPC Packages -->
    <PackageReference Include="Grpc.Net.Client" Version="2.76.0" />
    <PackageReference Include="Google.Protobuf" Version="3.32.0" />
    <PackageReference Include="Grpc.Tools" Version="2.76.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <!-- JWT Authentication -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.14.0" />

    <!-- CSV Processing -->
    <PackageReference Include="CsvHelper" Version="33.1.0" />

    <!-- Twilio for SMS -->
    <PackageReference Include="Twilio" Version="7.*" />

    <!-- Logging & Options -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- gRPC Protobuf Definitions --> 
    <Protobuf Include="Protos\cms.proto" GrpcServices="Client" />
    <Protobuf Include="Protos\staff.proto" GrpcServices="Client" />

  </ItemGroup>

  <ItemGroup>
    <!-- Embedded Seed Data -->
    <EmbeddedResource Include="Persistence\SeedData\*.csv" />
  </ItemGroup>
</Project>
