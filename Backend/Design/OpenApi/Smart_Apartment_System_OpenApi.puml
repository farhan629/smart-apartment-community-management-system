          minLength: 1
          maxLength: 255
        slotTypeId:
          type: string
          format: uuid
        statusId:
          type: string
          format: uuid
        location:
          type: string
          maxLength: 255
        rules:
          type: string
          maxLength: 2000
        imageUrl:
          type: string
          maxLength: 500
        isActive:
          type: boolean

    AmenitySlot:
      type: object
      properties:
        id:
          type: string
          format: uuid
        slotLabel:
          type: string
          example: "Morning Session"
        slotDate:
          type: string
          format: date
          example: "2024-07-20"
        startTime:
          type: string
          example: "09:00"
        endTime:
          type: string
          example: "10:00"
        maxCapacity:
          type: integer
          example: 1
