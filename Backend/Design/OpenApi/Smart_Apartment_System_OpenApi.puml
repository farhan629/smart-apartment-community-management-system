      summary: Get all Occupant roles
      description: |
        Returns all roles under the **Occupant** category.
        Occupant covers: **Owner** and **Tenant**.
        Use the returned `role_id` in the /signup request body.
        Public — callers haven't signed up yet, so no JWT is required.
      security: []
      responses:
        "200":
          description: List of Occupant roles retrieved successfully
          content:
            application/json:
              schema:
                type: object
                properties:
                  success:
                    type: boolean
                    example: true
                  category:
                    type: string
                    example: Occupant
                  description:
                    type: string
                    example: "Covers Owner and Tenant roles"
                  roles:
                    type: array
                    items:
                      $ref: '#/components/schemas/RoleDetail'
              example:
                success: true
                category: Occupant
                description: "Covers Owner and Tenant roles"
                roles:
                  - role_id: "d4e5f6a7-b8c9-1234-efab-cd5678901234"
                    role_name: Owner
                    category: Occupant
                    description: "Property owner with full residential access"
                    createdAt: "2024-01-01T00:00:00Z"
                  - role_id: "e5f6a7b8-c9d0-2345-fabc-de6789012345"
                    role_name: Tenant
                    category: Occupant
                    description: "Tenant/renter with residential access"
                    createdAt: "2024-01-01T00:00:00Z"
        "401":
          $ref: '#/components/responses/Unauthorized'
        "403":
          $ref: '#/components/responses/Forbidden'
        "500":
          $ref: '#/components/responses/InternalServerError'

