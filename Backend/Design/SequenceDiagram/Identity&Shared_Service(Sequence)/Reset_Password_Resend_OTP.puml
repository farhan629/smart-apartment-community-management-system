@startuml Auth_Part3
skinparam sequenceArrowThickness 1.2
skinparam roundcorner 6
skinparam sequenceBoxBorderColor #888
skinparam sequenceLifeLineBorderColor #AAAAAA
skinparam sequenceGroupBorderColor #888888
skinparam sequenceGroupBackgroundColor #F5F5F5
skinparam sequenceGroupFontSize 12
skinparam noteFontSize 11
skinparam sequenceParticipantFontSize 12
skinparam sequenceParticipantBackgroundColor #EFEFEF
skinparam sequenceParticipantBorderColor #888888

actor Resident as RES
actor "Admin" as ADM
participant "Client App" as APP
participant "API Gateway" as GW
participant "Auth API" as API
participant "Email Service" as EMAIL
database "Database" as DB

== 10. Forgot Password - Reset Password (Resident) ==
RES -> APP : Enter new password
APP -> GW : POST /auth/forgot-password/reset-password\n{resetToken, newPassword}
GW -> API : Forward request
API -> DB : Validate token & update password
alt Missing resetToken or newPassword
    API --> GW : 400 Bad Request\n"resetToken and newPassword are required"
    GW --> APP : 400
    APP --> RES : All fields are required
else Invalid reset token
    API --> GW : 400 Bad Request\n"Invalid reset token"
    GW --> APP : 400
    APP --> RES : Invalid or tampered token
else Reset session expired
    API --> GW : 401 Unauthorized\n"Reset session expired"
    GW --> APP : 401
    APP --> RES : Session expired, restart process
else Weak password
    API --> GW : 422 Unprocessable Entity\n"Password must contain uppercase,\nlowercase, number, special character"
    GW --> APP : 422
    APP --> RES : Password does not meet requirements
else Server error
    API --> GW : 500 Internal Server Error
    GW --> APP : 500
    APP --> RES : Something went wrong, try again
else OK
    API --> GW : 200 Password reset successfully
    GW --> APP : 200
    APP --> RES : Password reset successful
end

== 11. Forgot Password - Reset Password (Admin) ==
ADM -> APP : Enter new password
APP -> GW : POST /auth/forgot-password/reset-password\n{resetToken, newPassword}
GW -> API : Forward request
API -> DB : Validate token & update password
alt Missing resetToken or newPassword
    API --> GW : 400 Bad Request\n"resetToken and newPassword are required"
    GW --> APP : 400
    APP --> ADM : All fields are required
else Invalid reset token
    API --> GW : 400 Bad Request\n"Invalid reset token"
    GW --> APP : 400
    APP --> ADM : Invalid or tampered token
else Reset session expired
    API --> GW : 401 Unauthorized\n"Reset session expired"
    GW --> APP : 401
    APP --> ADM : Session expired, restart process
else Weak password
    API --> GW : 422 Unprocessable Entity\n"Password does not meet requirements"
    GW --> APP : 422
    APP --> ADM : Password does not meet requirements
else Server error
    API --> GW : 500 Internal Server Error
    GW --> APP : 500
    APP --> ADM : Something went wrong, try again
else OK
    API --> GW : 200 Password reset successfully
    GW --> APP : 200
    APP --> ADM : Password reset successful
end

== 12. Resend OTP (Resident) ==
RES -> APP : Request OTP resend
APP -> GW : POST /auth/forgot-password/resend-otp\n{email}
GW -> API : Forward request
API -> DB : Lookup email
alt Missing email field
    API --> GW : 400 Bad Request\n"email is required"
    GW --> APP : 400
    APP --> RES : Email is required
else Invalid email format
    API --> GW : 400 Bad Request\n"Invalid email format"
    GW --> APP : 400
    APP --> RES : Invalid email format
else Email not found
    API --> GW : 404 Not Found\n"Email not found"
    GW --> APP : 404
    APP --> RES : Email not registered
else Rate limit exceeded
    API --> GW : 429 Too Many Requests\n"Too many resend attempts. Please try again later"
    GW --> APP : 429
    APP --> RES : Too many attempts, try again later
else Email service failure
    API --> GW : 500 Internal Server Error
    GW --> APP : 500
    APP --> RES : Failed to resend OTP, try again
else OK
    API -> EMAIL : Resend OTP
    API --> GW : 200 OTP resent successfully
    GW --> APP : 200
    APP --> RES : New OTP sent to email
end

== 13. Resend OTP (Admin) ==
ADM -> APP : Request OTP resend
APP -> GW : POST /auth/forgot-password/resend-otp\n{email}
GW -> API : Forward request
API -> DB : Lookup email
alt Missing email field
    API --> GW : 400 Bad Request\n"email is required"
    GW --> APP : 400
    APP --> ADM : Email is required
else Invalid email format
    API --> GW : 400 Bad Request\n"Invalid email format"
    GW --> APP : 400
    APP --> ADM : Invalid email format
else Email not found
    API --> GW : 404 Not Found\n"Email not found"
    GW --> APP : 404
    APP --> ADM : Email not registered
else Rate limit exceeded
    API --> GW : 429 Too Many Requests\n"Too many resend attempts"
    GW --> APP : 429
    APP --> ADM : Too many attempts, try again later
else Email service failure
    API --> GW : 500 Internal Server Error
    GW --> APP : 500
    APP --> ADM : Failed to resend OTP, try again
else OK
    API -> EMAIL : Resend OTP
    API --> GW : 200 OTP resent successfully
    GW --> APP : 200
    APP --> ADM : New OTP sent to email
end

@enduml