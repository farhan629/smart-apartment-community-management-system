@startuml Auth_Part2
skinparam sequenceArrowThickness 1.2
skinparam roundcorner 6
skinparam sequenceBoxBorderColor #888
skinparam sequenceLifeLineBorderColor #AAAAAA
skinparam sequenceGroupBorderColor #888888
skinparam sequenceGroupBackgroundColor #F5F5F5
skinparam sequenceGroupFontSize 12
skinparam noteFontSize 11
skinparam sequenceParticipantFontSize 12
skinparam sequenceParticipantBackgroundColor #EFEFEF
skinparam sequenceParticipantBorderColor #888888

actor Resident as RES
actor "Admin" as ADM
actor "Security / Staff" as SEC
participant "Client App" as APP
participant "API Gateway" as GW
participant "Auth API" as API
participant "Email Service" as EMAIL
database "Database" as DB

== 5. Forgot Password - Send OTP (Resident) ==
RES -> APP : Enter registered email
APP -> GW : POST /auth/forgot-password/send-otp\n{email}
GW -> API : Forward request
API -> DB : Lookup email
alt Missing email field
    API --> GW : 400 Bad Request\n"email is required"
    GW --> APP : 400
    APP --> RES : Email is required
else Invalid email format
    API --> GW : 400 Bad Request\n"Invalid email format"
    GW --> APP : 400
    APP --> RES : Invalid email format
else Email not found
    API --> GW : 404 Not Found\n"Email not found"
    GW --> APP : 404
    APP --> RES : Email not registered
else Rate limit exceeded
    API --> GW : 429 Too Many Requests\n"Too many OTP requests. Please try again later"
    GW --> APP : 429
    APP --> RES : Too many attempts, try again later
else Email service failure
    API --> GW : 500 Internal Server Error
    GW --> APP : 500
    APP --> RES : Failed to send OTP, try again
else OK
    API -> EMAIL : Send OTP
    API --> GW : 200 OTP sent
    GW --> APP : 200
    APP --> RES : OTP sent to email
end

