    GW --> APP : 400
    APP --> SEC : Email and password are required
else Invalid credentials
    API --> GW : 401 Unauthorized\n"Invalid email or password"
    GW --> APP : 401
    APP --> SEC : Invalid email or password
else Account deactivated
    API --> GW : 403 Forbidden\n"Your account has been deactivated"
    GW --> APP : 403
    APP --> SEC : Account deactivated
else Account blocked
    API --> GW : 403 Forbidden\n"Your account has been blocked"
    GW --> APP : 403
    APP --> SEC : Account blocked
else Server error
    API --> GW : 500 Internal Server Error
    GW --> APP : 500
    APP --> SEC : Something went wrong, try again
else Valid
