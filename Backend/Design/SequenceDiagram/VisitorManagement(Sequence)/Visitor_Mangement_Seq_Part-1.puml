@startuml Visitor_Management_Part1
skinparam sequenceArrowThickness 1.2
 
skinparam roundcorner 6
skinparam sequenceBoxBorderColor #888
skinparam sequenceLifeLineBorderColor #AAAAAA
skinparam sequenceGroupBorderColor #888888
skinparam sequenceGroupBackgroundColor #F5F5F5
skinparam sequenceGroupFontSize 12
skinparam noteFontSize 11
skinparam sequenceParticipantFontSize 12
skinparam sequenceParticipantBackgroundColor #EFEFEF
skinparam sequenceParticipantBorderColor #888888
actor Resident as RES
 
participant "Auth Middleware" as AUTH
 
participant "Visitor API" as VAPI
 
participant "Visit API" as VISAPI
 
database "Database" as DB
== 1. Get Reference Data ==
RES -> VAPI : GET /visitor-types\n[Authorization: Bearer token]
 
VAPI -> AUTH : Validate JWT
 
AUTH --> VAPI : Authorized
alt Unauthorized
 
AUTH --> VAPI : 401 Unauthorized
 
VAPI --> RES : 401 Unauthorized
 
else Valid
 
VAPI -> DB : Fetch visitor types
 
DB --> VAPI : visitor type rows
 
VAPI --> RES : 200 OK\n[{ id, name }[]]
 
end
RES -> VAPI : GET /purpose-types\n[Authorization: Bearer token]
 
VAPI -> AUTH : Validate JWT
 
AUTH --> VAPI : Authorized
alt Unauthorized
 
AUTH --> VAPI : 401 Unauthorized
 
VAPI --> RES : 401 Unauthorized
 
else Valid
 
VAPI -> DB : Fetch purpose types
 
DB --> VAPI : purpose type rows
 
VAPI --> RES : 200 OK\n[{ id, name }[]]
 
end
== 2. Visitor Search (Autocomplete) ==
RES -> VAPI : GET /visitors?search={query}&page=1&limit=10\n[Authorization: Bearer token]
 
VAPI -> AUTH : Validate JWT
 
AUTH --> VAPI : Authorized
alt Unauthorized
 
AUTH --> VAPI : 401 Unauthorized
 
VAPI --> RES : 401 Unauthorized
 
else Valid
 
VAPI -> DB : Search visitors by name or phone number
 
DB --> VAPI : matching visitor rows
alt No results
    VAPI --> RES : 204 No Content
else Results found
    VAPI --> RES : 200 OK\n[{ id, name, phone_number, visitor_type, is_active }[]]
end
end
== 3. Create Visitor ==
RES -> VAPI : POST /visitors\n{ name, phone_number, email?, visitor_type_id }\n[Authorization: Bearer token]
 
VAPI -> AUTH : Validate JWT
 
AUTH --> VAPI : Authorized
alt Unauthorized
 
AUTH --> VAPI : 401 Unauthorized
 
VAPI --> RES : 401 Unauthorized
 
else Error
 
VAPI --> RES : 400 Bad Request\n[validation errors]
 
else Not Found
 
VAPI --> RES : 404 Not Found\n[visitor_type_id not found]
 
else Conflict
 
VAPI -> DB : Check existing visitor by phone number
 
DB --> VAPI : existing record
 
VAPI --> RES : 409 Conflict\n[phone number already exists]
 
else Success
 
VAPI -> DB : Create new visitor record
 
DB --> VAPI : new visitor_id
 
VAPI --> RES : 201 Created\n{ id }
 
end
== 4. Register Visit ==
RES -> VISAPI : POST /visits\n{ visitor_id | visitor{}, purpose_type_id, start_date, end_date }\n[Authorization: Bearer token]
 
VISAPI -> AUTH : Validate JWT — extract host_user_id, flat_id
 
AUTH --> VISAPI : Authorized (resident role)
alt Unauthorized
 
AUTH --> VISAPI : 401 Unauthorized
 
VISAPI --> RES : 401 Unauthorized
 
else Error
 
VISAPI --> RES : 400 Bad Request\n[validation / invalid date range / past date]
 
else Mutually exclusive violation
 
VISAPI --> RES : 422 Unprocessable Entity\n[send exactly one of visitor_id or visitor]
 
else Not Found
 
VISAPI --> RES : 404 Not Found\n[visitor_type_id or purpose_type_id not found]
 
else Success — existing visitor
 
VISAPI -> DB : Create new visit record for existing visitor (status=PENDING)
 
DB --> VISAPI : new visit_id
 
VISAPI --> RES : 201 Created\n{ id, status:PENDING, visitor_name,\nflat_number, purpose, start_date, end_date, created_at }
 
else Success — new visitor inline
 
VISAPI -> DB : Create new visitor record
 
DB --> VISAPI : new visitor_id
 
VISAPI -> DB : Create new visit record (status=PENDING)
 
DB --> VISAPI : new visit_id
 
VISAPI --> RES : 201 Created\n{ id, status:PENDING, visitor_name,\nflat_number, purpose, start_date, end_date, created_at }
 
end
@enduml